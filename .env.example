# Copy this file to ".env" and fill in your key. Never commit the real .env.
OPENAI_API_KEY=sk-your-key-here
# Optional — defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional — defaults to 4321
PORT=4321

# ---------- Contact form email (SMTP) ----------
# Required to actually send consultation-form submissions.
# Example (Gmail / Google Workspace): host smtp.gmail.com, port 587,
# user = your full address, pass = a 16-char Google "App Password"
# (create at https://myaccount.google.com/apppasswords — normal password won't work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kontakt@vebis.pl
SMTP_PASS=your-app-password-here
# Where leads are delivered (defaults to kontakt@vebis.pl)
CONTACT_TO=kontakt@vebis.pl
# From address on the email (defaults to SMTP_USER)
CONTACT_FROM=kontakt@vebis.pl
